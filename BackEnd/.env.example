# PromptWars Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_ME_WITH_BASE64_ENCODED_SECRET_AT_LEAST_256_BITS

# ─── Database (local dev — overridden by Cloud SQL in prod) ──────────────────
DB_USER=postgres
DB_PASS=postgres

# ─── GCP ─────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id

# ─── Beacon ───────────────────────────────────────────────────────────────────
BEACON_TTL_MINUTES=10
BEACON_EVICTION_INTERVAL_MS=120000
